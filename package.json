{
  "name": "voiceforge",
  "version": "1.0.0",
  "private": true,
  "description": "A private, local voice recording studio with creative voice effects.",
  "author": {
    "name": "RANOC304",
    "email": "aubinsprinter@gmail.com"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "package": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --win --dir --x64",
    "test:desktop": "electron scripts/smoke.cjs",
    "format": "prettier --write src desktop scripts README.md docs index.html package.json vite.config.ts tsconfig.json .github",
    "format:check": "prettier --check src desktop scripts README.md docs index.html package.json vite.config.ts tsconfig.json .github"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "6.2.7",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "com.ranoc304.voiceforge",
    "productName": "VoiceForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*.cjs",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "third-party/**/*",
      "desktop/icon.ico"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "artifactName": "VoiceForge-${version}-Windows.exe",
      "icon": "desktop/icon.ico",
      "signExecutable": false
    }
  },
  "license": "UNLICENSED",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
